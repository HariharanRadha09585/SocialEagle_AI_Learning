"""

#Vector Store

"""
from langchain_openai import OpenAIEmbeddings
from dotenv import load_dotenv
import os

from langchain_community.document_loaders import TextLoader
from langchain_community.vectorstores import FAISS
from langchain_text_splitters import RecursiveCharacterTextSplitter

  




load_dotenv()  # Load environment variables from .env file
apiKey = os.getenv("openai_api_Key")  # Get the OpenAI API key from environment variables

openai_embeddings = OpenAIEmbeddings(openai_api_key=apiKey)  # Initialize OpenAI embeddings with the API key
loader = TextLoader("Week_2/knowledge.txt", encoding="utf-8")  # Initialize a TextLoader with the created file
documents = loader.load()  # Load the documents from the file

splitter = RecursiveCharacterTextSplitter(
    chunk_size=80,  # Set the chunk size to 80 characters
    chunk_overlap=20  # Set the chunk overlap to 20 characters
)

chunks = splitter.split_documents(documents)  # Split the text into chunks

#embedding = openai_embeddings.embed_query(chunks)  # Generate the embedding for the text

vector_store = FAISS.from_documents(chunks, openai_embeddings)  # Create a FAISS vector store from the text chunks and embeddings

query = "Bim"  # Define a query to search in the vector store
results = vector_store.similarity_search(query,k=2)  # Perform a similarity search in the vector store

print("Results from similarity search:")  # Print a message indicating the results
for result in results:
    print(result.page_content)  # Print the content of each result

#save and load the vector store
vector_store.save_local("My_VectorStore")  # Save the vector store locally

#Load it back later
loaded_vector_store = FAISS.load_local("My_VectorStore", openai_embeddings,allow_dangerous_deserialization=True)  


#Retrieve the results from the loaded vector store

retriever = loaded_vector_store.as_retriever(search_kwargs={"k": 2})  # Create a retriever from the loaded vector store

question = "What is Bim?"  # Define a question to ask the retriever
results = retriever.invoke(question)  # Invoke the retriever with the question

print("Results from retriever:")  # Print a message indicating the results
for result in results:
    print(result.page_content)  # Print the content of each result  

